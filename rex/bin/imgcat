#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export LD_LIBRARY_PATH="$root/runtime-preview/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Kitty is supported in both native and Rex panes and survives Rex snapshots.
# Do not depend on environment variables in shells started before this bundle.
exec "$root/runtime-rex/bin/wezterm" imgcat --kitty "$@"
